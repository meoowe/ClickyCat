"unicode": 0,
"location": 0,
"echo": false,
"script": null
)]
}

[loggie]

general/show_system_specs=false
general/show_loggie_specs=0
timestamps/output_timestamps=true

[physics]

2d/run_on_separate_thread=true
common/physics_ticks_per_second=120
2d/physics_engine="GodotPhysics2D"

[quiver]

general/auth_token="uNUn36UfxediUx2zplZppkOit4CGTgLojjgdA6GA"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[steam]

initialization/app_data/app_id=480
initialization/processes/embed_callbacks=true
