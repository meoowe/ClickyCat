; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Clicky Cat"
config/version="2.4.0-22.09.26"
config/tags=PackedStringArray("g", "leo_is_a_gooner")
run/main_scene="res://scenes/title.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="clickycat"
config/auto_accept_quit=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.8")
run/low_processor_mode_sleep_usec=6897
boot_splash/image="uid://conp4c7oq4m06"
config/icon="res://icon.PNG"

[autoload]

Loggie="*res://addons/loggie/loggie.gd"
Global="*res://scenes/global.tscn"
Scenes="*res://scripts/autoloads/scenes.gd"
ScreenFader="*uid://cuour8s4k4fnn"

[blazium]

justamcp/tools/project_tools=true

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=800
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Clicky Cat"

[editor]

movie_writer/speaker_mode=3
movie_writer/movie_file="/projects/ClickyCat/uwu.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg", "res://addons/loggie/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://assets/img/": "red",
"res://builds/": "pink",
"res://scenes/": "purple",
"res://scripts/": "green",
"res://scripts/autoloads/": "teal"
}

[input]

move={
"deadzone": 0.5,
"events": [Object(InputEventKey,
"resource_local_to_scene": false,
"resource_name": "",
"device": -1,
"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": false,
